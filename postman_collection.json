		{
			"name": "05 - Checkout & Pagamento Pix (Idempotência + Redis Lock)",
			"item": [
				{
					"name": "Finalizar Pedido One-Page (Gera Pix com Trava Atômica)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Gera UUIDv4 para Idempotency-Key",
									"pm.collectionVariables.set(\"current_idempotency_key\", pm.variables.replaceIn('{{$guid}}'));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code é 201 ou 200\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"pm.test(\"Retorna detalhes do Pix e código copia e cola\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property(\"order_id\");",
									"    pm.expect(jsonData).to.have.property(\"payment_method\");",
									"    pm.expect(jsonData.payment_method).to.eql(\"pix\");",
									"    pm.expect(jsonData).to.have.property(\"pix_details\");",
									"    pm.expect(jsonData.pix_details).to.have.property(\"qr_code\");",
									"    pm.collectionVariables.set(\"order_id\", jsonData.order_id);",
